if (enemy.marshmallow.targetLookDir) {
  if (!enemy.marshmallow.lookDir) enemy.marshmallow.lookDir = { x: 0, y: 0 };
  
  if (enemy.marshmallow.lookDirTime > 0) {
    enemy.marshmallow.lookDirTime -= delta;
    // Move towards target
    enemy.marshmallow.lookDir.x += (enemy.marshmallow.targetLookDir.x - enemy.marshmallow.lookDir.x) * delta * 10.0;
    enemy.marshmallow.lookDir.y += (enemy.marshmallow.targetLookDir.y - enemy.marshmallow.lookDir.y) * delta * 10.0;
  } else {
    // Return to center
    enemy.marshmallow.lookDir.x += (0 - enemy.marshmallow.lookDir.x) * delta * 5.0;
    enemy.marshmallow.lookDir.y += (0 - enemy.marshmallow.lookDir.y) * delta * 5.0;
  }
}

const toRemove = [];